# Required – from GitHub Secrets when running in Actions
GROQ_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=
BLOG_POSTS_TABLE=BlogPosts

# Optional – topic-appropriate cover images via Unsplash search
# If not set, agent uses curated fallback images by topic (AI / Codespaces / default)
# UNSPLASH_ACCESS_KEY=

# Optional – higher GitHub API rate limit (in Actions, GITHUB_TOKEN is automatic)
# GITHUB_TOKEN=
